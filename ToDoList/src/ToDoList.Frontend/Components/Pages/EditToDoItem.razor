@page "/editToDoItem/{ItemId:int}"
@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models

@inject IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

@if (ToDoModel is not null)
{
    <EditForm Model="@ToDoModel" FormName="EditTodoItem" OnValidSubmit="@Submit">
        <DataAnnotationsValidator />
        <div>
            <label for="Name" class="form-label">Name</label>
            <InputText id="Name" @bind-Value="ToDoModel.Name" class="form-input" />
            <ValidationMessage For="() => ToDoModel.Name" />
        </div>
        <div>
            <label for="Description" class="form-label">Name</label>
            <InputText id="Description" @bind-Value="ToDoModel.Description" class="form-control" />
            <ValidationMessage For="() => ToDoModel.Description" />

        </div>
        <div>
            <label for="Category" class="form-label">Category</label>
            <InputText id="Category" @bind-Value="ToDoModel.Category" class="form-control" />
        </div>
        <InputCheckbox id="IsCompleted" @bind-Value="ToDoModel.IsCompleted" />

        <button type="submit">Submit</button>
    </EditForm>

    @ToDoModel.Name
    @ToDoModel.Description
    @ToDoModel.IsCompleted
    @ToDoModel.Category
}


<b>@ItemId</b>

@code {
    //id = jméno prvku, který chci měnit
    //bind value = jaká proměnná má být napojena na editovaný prvek

    protected override async Task OnInitializedAsync()
    {
        ToDoModel = await toDoItemsClient.ReadItemByIdAsync(ItemId);
        submitDelegate = LogSubmit;
        //submitDelegate += LogSubmit;
        // submitDelegate -= LogSubmit;

    }
    [Parameter]
    public int ItemId { get; set; }

    [SupplyParameterFromForm]
    public ToDoItemView ToDoModel { get; set; }
    public delegate void ToDoItemViewProcessingDelegate(ToDoItemView toDo);
    private ToDoItemViewProcessingDelegate submitDelegate;

    public async Task Submit()
    {
        await toDoItemsClient.UpdateItemAsync(ToDoModel);
        if (ToDoModel != null)
        {
            // pozor, výpis najdeme v záložce debug!
            submitDelegate.Invoke(ToDoModel);
            // může být také zapsáno jako submitDelegate?.Invoke(ToDoModel);
            // tj. bez podmínky

        }
        NavigationManager.NavigateTo("/");
    }
    public void LogSubmit(ToDoItemView toDo)
    {
        Console.WriteLine("Task nr. " + toDo.Id + " was edited.");
    }
}
